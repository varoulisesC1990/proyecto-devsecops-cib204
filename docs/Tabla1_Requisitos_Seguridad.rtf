\trowd\cellx2200\cellx5200\cellx7200\cellx9800\cellx12000
\pard\intbl\f0\fs18 Confidencialidad\cell
\pard\intbl\f0\fs18 Proteger secretos y datos sensibles (credenciales, tokens, claves API, secretos en scripts y Dockerfiles).\cell
\pard\intbl\f0\fs18 Usar GitHub Secrets para CI/CD; no almacenar secretos en el repositorio; mantener .env fuera del control de versiones; habilitar secret scanning y hooks preventivos; cifrado en tránsito y acceso con privilegios mínimos.\cell
\pard\intbl\f0\fs18 Resultado de secret scanning sin hallazgos; cero commits con credenciales; verificaci\'f3n de configuraciones de secretos y tokens rotados.\cell
\pard\intbl\f0\fs18 Fuga de credenciales, acceso no autorizado, uso indebido de recursos, p\'e9rdida de datos y deterioro reputacional.\cell
\row
\trowd\cellx2200\cellx5200\cellx7200\cellx9800\cellx12000
\pard\intbl\f0\fs18 Integridad\cell
\pard\intbl\f0\fs18 Garantizar que el c\'f3digo, dependencias e imagenes no sean modificadas de forma maliciosa.\cell
\pard\intbl\f0\fs18 Branch protection, revisi\'f3n de c\'f3digo obligatoria, firma/validaci\'f3n de commits, lockfiles, SBOM, Dependabot/Snyk, escaneo de im\'e1genes Docker y controles de cadena de suministro.\cell
\pard\intbl\f0\fs18 Vulnerabilidades de dependencias controladas, estado de validaciones de la rama, ausencia de cambios no aprobados y escaneos de imagenes correctos.\cell
\pard\intbl\f0\fs18 Inyecci\'f3n de c\'f3digo malicioso, backdoors, dependencias comprometidas y riesgo en producci\'f3n.\cell
\row
\trowd\cellx2200\cellx5200\cellx7200\cellx9800\cellx12000
\pard\intbl\f0\fs18 Disponibilidad\cell
\pard\intbl\f0\fs18 Mantener servicios, pipelines y artefactos operativos y recuperables ante fallos o ataques.\cell
\pard\intbl\f0\fs18 Pipelines resilientes, runners redundantes, limites de recursos, backups, monitorizaci\'f3n, alertas y pruebas de recuperaci\'f3n ante incidentes.\cell
\pard\intbl\f0\fs18 Uptime/sla, tasa de ejecuciones CI correctas, frecuencia y \'e9xito de restauraciones y cobertura de monitorizaci\'f3n.\cell
\pard\intbl\f0\fs18 Interrupci\'f3n del desarrollo y despliegue, p\'e9rdida de productividad, retrasos operativos y riesgo de p\'e9rdida de artefactos.\cell
\row
\trowd\cellx2200\cellx5200\cellx7200\cellx9800\cellx12000
\pard\intbl\f0\fs18 Autenticidad / Rendi\'f3n de cuentas\cell
\pard\intbl\f0\fs18 Asegurar que cada acci\'f3n (commit, merge, despliegue) sea atribuible y autorizada.\cell
\pard\intbl\f0\fs18 2FA obligatorio, RBAC, protecci\'f3n de ramas, auditor\'eda de cambios, registro de despliegues y rotaci\'f3n peri\'f3dica de tokens y claves.\cell
\pard\intbl\f0\fs18 Porcentaje de usuarios con 2FA, merges aprobados, registro de auditor\'eda y revisi\'f3n de logs.\cell
\pard\intbl\f0\fs18 Cambios no autorizados, dificultad para investigar incidentes, mayor riesgo legal y p\'e9rdida de confianza.\cell
\row
